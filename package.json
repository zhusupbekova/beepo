{
  "name": "beepo",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "for f in extension/*.js extension/*/*.js; do node --check \"$f\" || exit 1; done",
    "icons": "node scripts/make-icons.js && node scripts/make-android-icon.js",
    "build": "node scripts/build.js",
    "locales": "node scripts/make-locales.js",
    "store": "node scripts/store-assets.js",
    "social": "node scripts/social-assets.js",
    "fixtures": "node scripts/make-fixtures.js",
    "play": "node scripts/play-assets.js",
    "promo": "node scripts/promo-videos.js",
    "posts": "node scripts/social-posts.js"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
